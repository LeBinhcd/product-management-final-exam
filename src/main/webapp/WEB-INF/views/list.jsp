<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.codegym.product.model.Product" %><html><head><title>Quản lý sản phẩm</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main><h1>Quản lý sản phẩm</h1><a class="button" href="products?action=new">Thêm sản phẩm</a><table><tr><th>ID</th><th>Tên sản phẩm</th><th>Giá</th><th>Số lượng</th><th>Thao tác</th></tr><% for(Product p:(List<Product>)request.getAttribute("products")){ %><tr><td><%=p.getId()%></td><td><%=p.getName()%></td><td><%=p.getPrice()%></td><td><%=p.getQuantity()%></td><td><a href="products?action=edit&id=<%=p.getId()%>">Sửa</a> <a href="products?action=delete&id=<%=p.getId()%>" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">Xóa</a></td></tr><% } %></table></main></body></html>
