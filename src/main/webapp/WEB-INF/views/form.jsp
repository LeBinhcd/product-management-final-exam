<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.codegym.product.model.Product" %><% Product p=(Product)request.getAttribute("product"); boolean edit=p.getId()!=0; %><html><head><title><%=edit?"Sửa":"Thêm"%> sản phẩm</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main><h1><%=edit?"Sửa":"Thêm"%> sản phẩm</h1><form method="post" action="products"><% if(edit){ %><input type="hidden" name="id" value="<%=p.getId()%>"><% } %><label>Tên sản phẩm<input name="name" value="<%=p.getName()==null?"":p.getName()%>" required></label><label>Giá<input type="number" name="price" min="0" step="0.01" value="<%=p.getPrice()==null?"":p.getPrice()%>" required></label><label>Số lượng<input type="number" name="quantity" min="0" value="<%=p.getQuantity()%>" required></label><button type="submit">Lưu</button> <a href="products">Hủy</a></form></main></body></html>
